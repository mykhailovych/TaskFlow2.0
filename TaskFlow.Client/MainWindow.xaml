<Window x:Class="TaskFlow.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskFlow.Client.ViewModels"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="TaskFlow - Kanban Дошка" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель (Header) -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="TaskFlow" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserNameDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основна робоча область для колонок -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Columns}" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Колонки будуть розташовані горизонтально -->
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Background="#E5E7EB" CornerRadius="8" Margin="0,0,20,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Для заголовка -->
                                    <RowDefinition Height="*"/>
                                    <!-- Для списку завдань -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Для кнопки -->
                                </Grid.RowDefinitions>

                                <!-- Назва колонки -->
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#374151" Margin="0,0,0,10"/>

                                <!-- Список карток завдань -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Tasks}"
                                                  Background="Transparent"
                                                  MinHeight="300"
                                                  VerticalAlignment="Stretch"
                                                  dd:DragDrop.IsDragSource="True"
                                                  dd:DragDrop.IsDropTarget="True"
                                                  dd:DragDrop.DropHandler="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <!-- Дизайн однієї картки -->
                                                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10">

                                                    <!-- Додаємо прив'язку подвійного кліку до нашої нової команди -->
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick" 
                                                                      Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>

                                                    <Grid Background="Transparent">
                                                        <!-- Прозорий фон важливий для подвійного кліку по всьому полю -->
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Мітки пріоритету та дедлайну -->
                                                            <RowDefinition Height="*"/>
                                                            <!-- Текст -->
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- МІТКИ (Trello Tags) -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">

                                                            <!-- Мітка пріоритету з динамічними кольорами -->
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <!-- Колір за замовчуванням (Medium - Жовтий) -->
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                        <Style.Triggers>
                                                                            <!-- Якщо Low - Зелений -->
                                                                            <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                            </DataTrigger>
                                                                            <!-- Якщо High - Червоний -->
                                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <!-- Текст за замовчуванням (Medium - Темно-жовтий) -->
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                            <Style.Triggers>
                                                                                <!-- Якщо Low - Темно-зелений -->
                                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                                                </DataTrigger>
                                                                                <!-- Якщо High - Темно-червоний -->
                                                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Мітка дедлайну (з іконкою, приховується якщо пусто) -->
                                                            <Border CornerRadius="4" Padding="6,2" Background="#F3F4F6">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <!-- Якщо Deadline дорівнює Null - ховаємо цей блок повністю -->
                                                                            <DataTrigger Binding="{Binding Deadline}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="📅 " FontSize="11" Margin="0,0,2,0"/>
                                                                    <TextBlock Text="{Binding Deadline, StringFormat='dd.MM.yyyy'}" FontSize="11" FontWeight="Medium" Foreground="#4B5563"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Кнопка видалення (Хрестик) -->
                                                        <Button Grid.Row="0" Grid.Column="1" Content="✕" 
                                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" Foreground="#EF4444" BorderThickness="0" 
                                                                FontSize="14" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Top" Padding="5,0"/>

                                                        <!-- Текст завдання -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,10,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" FontSize="14"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Кнопка додавання нового завдання -->
                                <Button Grid.Row="2" Content="+ Додати завдання" 
                                        Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="#2563EB" FontWeight="SemiBold" 
                                        BorderThickness="0" Margin="0,10,0,0" Cursor="Hand" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>