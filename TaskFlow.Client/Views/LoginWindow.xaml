<Window x:Class="TaskFlow.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskFlow.Client.ViewModels"
        x:Name="loginWin"
        Title="TaskFlow - Авторизація" Height="450" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <!-- Заголовок -->
            <TextBlock Text="TaskFlow" FontSize="32" FontWeight="Bold" 
                       Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Система управління завданнями" FontSize="12" 
                       Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Поле Введення Логіна -->
            <TextBlock Text="Ім'я користувача:" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Height="36" Padding="8,6" FontSize="14" Margin="0,0,0,15"/>

            <!-- Поле Введення Пароля -->
            <TextBlock Text="Пароль:" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                     Height="36" Padding="8,6" FontSize="14" Margin="0,0,0,15"/>

            <!-- Повідомлення про помилку/статус -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" 
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Кнопки дій -->
            <Button Content="Увійти" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=loginWin}"
                    Height="40" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10"/>

            <Button Content="Зареєструватися" 
                    Command="{Binding RegisterCommand}" 
                    Height="36" Background="Transparent" Foreground="#2563EB" 
                    FontSize="13" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>