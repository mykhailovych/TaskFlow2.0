<Window x:Class="TaskFlow.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskFlow.Client.ViewModels"
        x:Name="loginWin"
        Title="TaskFlow - Авторизація" Height="520" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Grid Margin="25,15">
        <StackPanel VerticalAlignment="Center">
            <!-- Заголовок -->
            <TextBlock Text="TaskFlow" FontSize="30" FontWeight="Bold" 
                       Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Система управління завданнями" FontSize="12" 
                       Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Підказка, якщо користувач уже логінився раніше -->
            <StackPanel Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSavedLogins}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Ви вже входили раніше — оберіть акаунт, щоб підставити пароль:"
                           FontSize="12" Foreground="#374151" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding SavedLogins}"
                          SelectedItem="{Binding SelectedSavedLogin}"
                          DisplayMemberPath="Username"/>
                <TextBlock Text="{Binding LoginHint}"
                           FontSize="11" Foreground="#059669" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Поле Введення Логіна -->
            <TextBlock Text="Ім'я користувача:" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameTextBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Height="34" Padding="8,5" FontSize="14" Margin="0,0,0,10"/>

            <!-- Поле Введення Пароля -->
            <TextBlock Text="Пароль:" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
            <TextBox x:Name="PasswordTextBox"
                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                     Height="34" Padding="8,5" FontSize="14" Margin="0,0,0,10"/>

            <!-- Повідомлення про помилку/статус -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" 
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Кнопки дій -->
            <Button Content="Увійти" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=loginWin}"
                    Height="38" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,8"/>

            <Button Content="Зареєструватися" 
                    Command="{Binding RegisterCommand}" 
                    Height="34" Background="Transparent" Foreground="#2563EB" 
                    FontSize="13" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>