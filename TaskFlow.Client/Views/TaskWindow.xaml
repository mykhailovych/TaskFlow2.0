<Window x:Class="TaskFlow.Client.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="taskWin"
        Title="Завдання" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F9FAFB">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Деталі завдання" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

            <TextBlock Text="Назва:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5" FontSize="14" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Пріоритет:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <ComboBox SelectedValue="{Binding Priority}" SelectedValuePath="Content" Height="35" Padding="5">
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Дедлайн:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Deadline}" Height="35" Padding="5"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Опис:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="120" Padding="5" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=taskWin}"
                        Width="90" Height="35" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                    <TextBlock Text="Скасувати" Foreground="#6B7280" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <Button Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=taskWin}"
                        Width="100" Height="35" Background="#2563EB" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="Зберегти" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>