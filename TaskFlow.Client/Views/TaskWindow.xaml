<Window x:Class="TaskFlow.Client.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Деталі завдання" Height="650" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Деталі завдання" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

        <!-- Основна форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Назва -->
                <TextBlock Text="Назва:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Пріоритет -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Пріоритет:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" 
          SelectedValuePath="Content" 
          Height="30">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Дедлайн (Дата + Години + Хвилини) -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Дедлайн:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Вибір дати -->
                            <DatePicker SelectedDate="{Binding SelectedDate}" Width="110" Height="30" Margin="0,0,4,0"/>
                            <!-- Години -->
                            <TextBox Text="{Binding SelectedHour, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="30" MaxLength="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <TextBlock Text=":" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
                            <!-- Хвилини -->
                            <TextBox Text="{Binding SelectedMinute, UpdateSourceTrigger=PropertyChanged}" Width="30" Height="30" MaxLength="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Опис -->
                <TextBlock Text="Опис:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,15"/>

                <!-- Коментарі -->
                <TextBlock Text="Коментарі:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding Comments}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="10" Foreground="#9CA3AF"/>
                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Додавання коментаря -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Надіслати" Command="{Binding AddCommentCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" Width="80" Height="30" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижня панель з кнопками -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Скасувати" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="90" Height="35" Background="Transparent" Foreground="#4B5563" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="Зберегти" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100" Height="35" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>